<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.example.inventory.mapper.ReservedItemMapper">

	<resultMap id="reservedItemMapper"
		type="com.example.inventory.model.ReservedItem">
		<id property="orderId" column="order_id" />
		<id property="sku" column="sku" />
		<result property="qty" column="qty" />
	</resultMap>

	<select id="findAllById" resultMap="reservedItemMapper">
		SELECT order_id, sku, qty
		FROM inventory_db.reservations
		WHERE order_id = #{orderId}
	</select>
	<insert id="insert">
		INSERT INTO inventory_db.reservations(
		order_id,
		sku,
		qty)
		
		VALUES (#{orderId},#{sku},#{qty})
	</insert>
	<delete id="deleteByOrderId">
		DELETE FROM inventory_db.reservations
		WHERE order_id = #{orderId}
	</delete>
</mapper>
