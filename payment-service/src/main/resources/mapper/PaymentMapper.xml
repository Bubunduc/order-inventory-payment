<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.example.inventory.mapper.ProcessedOrderMapper">
	
	<resultMap id="PaymentResultMap"
		type="com.example.inventory.model.Payment">
		<id property="id" column="id" />
		<result property="orderId" column="order_id" />
		<result property="amount" column="amount" />
		<result property="status" column="status" />
	</resultMap>
	
	<insert id="insertIfAbsent">
		INSERT INTO payment_db.payments(order_id,amount,status)
		VALUES (#{orderId},#{amount},#{status})
	</insert>
	<update id="updateStatus">

		UPDATE payment_db.payments
		SET status = #{status},
		updated_at =
		CURRENT_TIMESTAMP
		WHERE id = #{id}

	</update>
</mapper>